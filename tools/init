#!/usr/bin/env bash
# Initialize a client from the GitHub metadata provisioned by InfraOps.

set -eo pipefail

origin=$(git remote get-url origin)
metadata=$(gh repo view "$origin" --json name,nameWithOwner,description --jq '.name, .nameWithOwner, (.description // "")')
{
  IFS= read -r name
  IFS= read -r repository
  description=$(cat)
} <<< "$metadata"
user=$(whoami)

if [[ -z ${description//[[:space:]]/} ]]; then
  printf 'Set the repository description in InfraOps before initializing.\n' >&2
  exit 1
fi

# Shared Make targets use the checkout directory as the binary name.
if [[ $(basename "$PWD") != "$name" ]]; then
  printf 'Clone the repository into a directory named %s before initializing.\n' "$name" >&2
  exit 1
fi

# Get all the submodules.
git submodule sync && git submodule update --init

# Clean up.
rm -rf vendor test/vendor go-client-template
make -C test clean-reports

# Replace template names only in this repository's tracked regular files.
while IFS= read -r -d '' file; do
  [[ -f $file && ! -L $file ]] || continue
  sed -i -e "s|alexfalkowski/go-client-template|$repository|g" \
    -e "s/go-client-template/$name/g" "$file"
done < <(git ls-files -z -- . ':!:bin' ':!:tools' ':!:README.md' ':!:.env' ':!:.env.*')

# Insert the description last so its text is preserved literally.
readme=$(< README.md)
readme=${readme//'alexfalkowski/go-client-template'/"$repository"}
readme=${readme//'go-client-template'/"$name"}
readme=${readme/'<!-- template:setup -->'*'<!-- /template:setup -->'/}
readme=${readme/'<!-- repository:description -->'*'<!-- /repository:description -->'/"$description"}
printf '%s\n' "$readme" > README.md

# Override test files.
find "test" -type f -name "*.rb" -exec sed -i "s/Example/${name^}/g" {} +
find "test" -type f -name "*.rb" -exec sed -i "s/example/$name/g" {} +
mv "test/lib/example.rb" "test/lib/$name.rb"

# Fix style issues.
make dep && make format && make fix-lint

# Remove files that are not needed.
rm -rf "tools"

# Create branch.
git checkout -b "$user/feat/init" && make msg="init $name" ready
